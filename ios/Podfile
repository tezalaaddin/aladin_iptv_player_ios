# Windows-to-iOS Migration Resilient Podfile

# 1. Flutter Helper Yolunu Tespit Et
def flutter_root
  # Codemagic veya yerel ortamda FLUTTER_ROOT env kontrolü
  root = ENV['FLUTTER_ROOT']
  if root.nil? || root.empty?
    # Eğer env yoksa, flutter config üzerinden bulmaya çalış (yavaş ama güvenli fallback)
    begin
      root = `flutter config --machine`.match(/"flutterRoot":\s*"([^"]+)"/)[1]
    rescue
      # Hiçbir şey bulunamazsa varsayılan SDK yollarını deneme (Mac için tipik yerler)
      ['/Users/builder/programs/flutter', '/opt/flutter'].each do |path|
        return path if File.exist?(path)
      end
    end
  end
  root
end

f_root = flutter_root
podhelper_path = File.join(f_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')

if File.exist?(podhelper_path)
  require podhelper_path
else
  # Son çare: Proje içindeki kopyaya güven (eğer varsa)
  puts "Uyarı: Flutter SDK içinde podhelper bulunamadı, yerel kopyaya bakılıyor..."
  require_relative 'Flutter/podhelper'
end

platform :ios, '14.0'

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  if defined?(flutter_install_all_ios_pods)
    flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    if defined?(flutter_additional_ios_build_settings)
      flutter_additional_ios_build_settings(target)
    end

    target.build_configurations.each do |config|
      # Jailbreak ve İmzasız Build Ayarları
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['PROVISIONING_PROFILE'] = ''
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
      config.build_settings['DEVELOPMENT_TEAM'] = ''

      # iOS 14+ için bazı kütüphane uyumlulukları
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end
